{
  "version": 2,
  "name": "smgpub",
  "builds": [
    {
      "src": "apps/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }



  
  "rewrites": [
    { "source": "/api/(.*)", "destination": "apps/api/index.js" },
    { "source": "/(.*)", "destination": "apps/web/$1" }
  ]
}
